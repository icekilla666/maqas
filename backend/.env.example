# Docker Compose overrides these two values for production.
DATABASE_URL=postgresql+asyncpg://myuser:CHANGE_ME@db:5432/maqas_database
VERIFY_EMAIL_URL=https://maqas.ru/verify-email

# Keep the current SECRET_KEY when updating an existing installation.
# For a NEW installation, generate it with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=60

SMTP_SERVER=CHANGE_ME
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=CHANGE_ME

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
